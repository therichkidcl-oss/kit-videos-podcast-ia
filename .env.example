# Copia este archivo como .env y completa tus valores ABRIENDO EL ARCHIVO TU MISMO (Bloc de notas, VS Code...).
# El .env esta en .gitignore: NUNCA lo subas ni pegues sus valores en un chat (tampoco en el de Claude).
# Los scripts leen cada key solo cuando la necesitan y nunca la imprimen.

# --- APIs ---
# HeyGen (solo formato podcast): https://app.heygen.com -> Settings > API -> copia tu "API Token" y pegalo despues del =
HEYGEN_API_KEY=
# Saldo minimo que debe quedar en HeyGen (unidades; 60 = 1 dolar). podcast/heygen.sh para antes de bajar de aqui.
# Vacio = 0.
HEYGEN_PISO=

# Telegram (opcional): bot creado con @BotFather y tu chat id (escribele a @userinfobot). Si estan, entregar.sh te manda cada video.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Rutas (opcionales; por defecto todo vive dentro del kit). En Windows usa C:/... con barras normales. ---
# Python del entorno principal (motor, alineacion, Whisper, 3D). Por defecto .venv/Scripts/python.exe o .venv/bin/python
PY=
# Python del entorno de la voz (Qwen3-TTS). Por defecto .venv-tts/Scripts/python.exe o .venv-tts/bin/python
PY_TTS=
# Nombre de tu voz clonada (carpeta voces/<VOZ>/). Si esta vacio se usa marca.json > voz
VOZ=
# Carpeta donde quedan los MP4 terminados. Por defecto entregas/
ENTREGAS=
# Carpeta con los OBJ de BodyParts3D (isa_BP3D_4.0_obj_99 y partof_BP3D_4.0_obj_99). Por defecto modelos/bp3d
BP3D_DIR=
